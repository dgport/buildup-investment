# Copy to .env (shared keys) – API URLs go in .env.development / .env.production
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# .env.development
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
# NEXT_PUBLIC_API_IMAGE_URL=http://localhost:3000

# .env.production
# NEXT_PUBLIC_API_BASE_URL=https://api.buildup.ge/api
# NEXT_PUBLIC_API_IMAGE_URL=https://api.buildup.ge

# Public site origin (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://buildup.ge

# Company contact details (footer, contact page, structured data)
NEXT_PUBLIC_CONTACT_PHONE=+995 5XX XX XX XX
NEXT_PUBLIC_CONTACT_EMAIL=info@buildup.ge
NEXT_PUBLIC_CONTACT_FACEBOOK=https://facebook.com/yourpage
NEXT_PUBLIC_CONTACT_INSTAGRAM=https://instagram.com/yourpage
