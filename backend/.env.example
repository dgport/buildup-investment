# ── Database ────────────────────────────────────────────────────────────────
# Local development: the API runs on your machine, Postgres on localhost.
# docker-compose.dev.yml / docker-compose.prod.yml override DATABASE_URL via
# `environment:` so containers always use their own "postgres" service.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/buildup?schema=public

NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_TOKEN_EXPIRATION=15m
JWT_REFRESH_TOKEN_EXPIRATION=7d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ── E-mail (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@buildup.ge

# ── Frontend ────────────────────────────────────────────────────────────────
# Used for e-mail links, Google OAuth redirects and CORS
FRONTEND_URL=http://localhost:3001
# Extra allowed CORS origins, comma separated (optional)
CORS_ORIGINS=

# ── Listings ────────────────────────────────────────────────────────────────
# Fallback phone for listings whose owner has none (optional; seeded into site_settings)
DEFAULT_CONTACT_PHONE=
