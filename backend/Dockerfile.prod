FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY prisma ./prisma/
COPY prisma.config.ts tsconfig*.json nest-cli.json ./
RUN npx prisma generate

COPY . .
RUN npm run build


FROM node:20-alpine

WORKDIR /app
ENV NODE_ENV=production

COPY package*.json ./
RUN npm ci --omit=dev

# prisma CLI (migrate deploy at container start) + generated client
COPY prisma ./prisma/
COPY prisma.config.ts ./
RUN npx prisma generate

COPY --from=builder /app/dist ./dist
# pre-rendered watermark PNGs (no fonts needed at runtime)
COPY assets ./assets

# volume mount points: served uploads + private originals
RUN mkdir -p /app/public/uploads /app/storage/originals

EXPOSE 3000

CMD ["node", "dist/main.js"]
